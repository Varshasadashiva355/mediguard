# ==============================================================================
# MediGuard AI – Environment Configuration Template
# Intelligent Cardiac Monitoring. Smarter Clinical Decisions.
# ==============================================================================

# Application Environment
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
PORT=5000
DEBUG=True

# Security & CORS
# Restricted to trusted frontend origins (e.g. http://localhost:3000, http://127.0.0.1:5500, http://localhost:5000)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:5500
JWT_SECRET_KEY=change-this-secure-jwt-secret-key-for-internal-sessions-or-tests
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=12

# Rate Limiting
LOGIN_RATE_LIMIT=5/minute

# Supabase Credentials (RULE 6: Service-role key remains strictly server-side)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-found-in-api-settings

# Supabase Storage Bucket (Private bucket for ECG files)
SUPABASE_ECG_BUCKET=ecg-files

# Mock / Offline Demo Mode (Set to true to run fully self-contained without live Supabase cloud connectivity)
OFFLINE_DEMO_MODE=true

# Hospital Emergency Protocol Contact Configuration
HOSPITAL_EMERGENCY_CODE_BLUE_EXT=2222
HOSPITAL_CARDIAC_CATH_LAB_EXT=4400
HOSPITAL_ICU_TRIAGE_EXT=3300
